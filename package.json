{
  "name": "quiet-profile-browsing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "web-ext lint",
    "start": "web-ext run --firefox-profile=dev --keep-profile-changes --profile-create-if-missing",
    "build": "web-ext build --overwrite-dest --ignore-files tests docs package.json package-lock.json dev"
  },
  "devDependencies": {
    "web-ext": "^8.10.0"
  }
}
